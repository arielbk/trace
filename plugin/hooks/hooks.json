{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "trace hook session-start",
        "powershell": "trace hook session-start"
      },
      {
        "type": "prompt",
        "prompt": "Consult the installed Trace skill before beginning work. If this session is not bound, use Trace to bind or re-enter the task."
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "trace hook stop",
        "powershell": "trace hook stop"
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "trace hook subagent-stop",
        "powershell": "trace hook subagent-stop"
      }
    ]
  }
}
